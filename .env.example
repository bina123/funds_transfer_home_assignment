###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_to_a_random_32_char_string
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format: mysql://USER:PASSWORD@HOST:PORT/DB_NAME?serverVersion=8.0&charset=utf8mb4
# Docker default host is "db" (service name in docker-compose.yml)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@db:3306/DB_NAME?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

# Redis — used for rate limiting
# Docker default host is "redis" (service name in docker-compose.yml)
# Local (no Docker): redis://127.0.0.1:6379
REDIS_URL="redis://redis:6379"

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
